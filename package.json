{
  "name": "land-divider",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "build:pages": "tsc -b && vite build --base=/land-divider/",
    "deploy": "npm run build:pages && gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.45",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
